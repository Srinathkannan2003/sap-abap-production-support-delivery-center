{
  "name": "sap-abap-production-support-delivery-center",
  "version": "1.0.0",
  "description": "Portfolio-ready SAP ABAP production support and delivery center built with Angular, Material, RxJS, Express, and mock JWT authentication.",
  "scripts": {
    "start": "ng serve",
    "build": "ng build --configuration production --base-href /sap-abap-production-support-delivery-center/",
    "test": "ng test",
    "api": "node backend/server.js",
    "json-server": "json-server --watch backend/db.json --port 3001",
    "dev": "concurrently \"npm run api\" \"npm start\"",
    "deploy:gh-pages": "npm run build && angular-cli-ghpages --dir=dist/sap-abap-production-support-delivery-center/browser"
  },
  "private": false,
  "dependencies": {
    "@angular/animations": "^20.0.0",
    "@angular/cdk": "^20.0.0",
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/material": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/router": "^20.0.0",
    "chart.js": "^4.4.9",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "lowdb": "^7.0.1",
    "rxjs": "^7.8.1",
    "tslib": "^2.6.3",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.0.0",
    "@angular/cli": "^20.0.0",
    "@angular/compiler-cli": "^20.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jasmine": "^5.1.4",
    "@types/jsonwebtoken": "^9.0.6",
    "angular-cli-ghpages": "^2.0.3",
    "concurrently": "^8.2.2",
    "jasmine-core": "^5.7.1",
    "json-server": "^1.0.0-beta.3",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "typescript": "~5.8.0"
  }
}
